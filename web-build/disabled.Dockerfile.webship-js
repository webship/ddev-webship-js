#ddev-generated
# Debian images by default disable apt caching, so turn it on until we finish
# the build.
RUN mv /etc/apt/apt.conf.d/docker-clean /etc/apt/docker-clean-disabled

# Refresh the sury.org PHP signing key. The DDEV base image ships with the
# sury.org PHP PPA, and its signing key may have expired. Refreshing it allows
# apt-get update and playwright install-deps to succeed.
RUN wget -qO /usr/share/keyrings/deb.sury.org-php.gpg https://packages.sury.org/php/apt.gpg 2>/dev/null \
  || curl -sSL https://packages.sury.org/php/apt.gpg -o /usr/share/keyrings/deb.sury.org-php.gpg 2>/dev/null \
  || true

RUN apt-get update

# Install webship-js npm dependencies and Playwright browsers.
#
# Manual changes to Dockerfile.webship-js will be reverted every time ddev
# start is run. In general, edit this file instead.
#
# This step:
# 1. Creates a copy of the webship-js directory in the image (via bind mount).
#    A pre-start hook copies test/webship-js into .ddev/web-build/webship-js
#    so Docker can access it here.
# 2. Runs npm install to install webship-js and its dependencies (including
#    Playwright). Browsers are then installed to ~/.cache/ms-playwright.
# 3. Removes the temporary copy so that future ddev get's work correctly.
#
# See https://github.com/ddev/ddev/issues/4727.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  --mount=type=cache,target=/dot-cache,sharing=locked \
  --mount=type=bind,source=./webship-js,target=/webship-js \
  sudo -u $username mkdir -p /var/www/html/test \
  && cp -a /webship-js /var/www/html/test \
  && chown -R $username:$username /var/www/html/test/webship-js \
  && chown -R $username:$username /dot-cache \
  && sudo -u $username ln -s /dot-cache /home/$username/.cache \
  && cd /var/www/html/test/webship-js \
  && if [ -f yarn.lock ]; then \
       export JS_PKG_MANAGER=yarn; \
       corepack enable; \
       sudo -u $username $JS_PKG_MANAGER; \
     else \
       sudo -u $username npm install; \
     fi \
  && sudo -u $username npx playwright install-deps \
  && sudo -u $username npx playwright install \
  && rm -rf /var/www/html/test/webship-js \
  && rm /home/$username/.cache \
  && sudo -u $username mkdir -p /home/$username/.cache \
  && sudo -u $username cp -a /dot-cache/* /home/$username/.cache/

# We're done with apt so disable caching again for the final image.
RUN mv /etc/apt/docker-clean-disabled /etc/apt/apt.conf.d/docker-clean
